<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeFrameworkVersion>10.0.12</RuntimeFrameworkVersion>
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants Condition="'$(PalQualificationObject)' != ''">$(DefineConstants);PAL_QUALIFICATION</DefineConstants>
    <StripSymbols>false</StripSymbols>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <PalRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../..'))</PalRoot>
    <PalLib Condition="'$(PalLib)' == ''">$(PalRoot)/target/release/libdotnet_pal_standalone.a</PalLib>
    <PalObserverObject Condition="'$(PalObserverObject)' == ''">$(PalRoot)/artifacts/gc_wrap.o</PalObserverObject>
    <PalWrap Condition="'$(PalWrap)' == ''">true</PalWrap>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="RuntimeQualification.cs" Condition="'$(PalQualificationObject)' == ''" />
    <DirectPInvoke Include="__Internal" />
    <NativeLibrary Include="$(PalObserverObject)" />
    <NativeLibrary Include="$(PalLib)" />
    <NativeLibrary Include="$(PalQualificationObject)" Condition="'$(PalQualificationObject)' != ''" />
    <NativeLibrary Include="$(PalHostObject)" Condition="'$(PalHostObject)' != ''" />
  </ItemGroup>
  <Import Project="../../artifacts/wrap.props" Condition="'$(PalWrap)' == 'true'" />
  <Target Name="PalAuditRuntime" BeforeTargets="LinkNative" DependsOnTargets="SetupOSSpecificProps">
    <Error Condition="'$(RuntimeFrameworkVersion)' != '10.0.12'" Text="This probe requires runtime 10.0.12" />
    <WriteLinesToFile File="$(PalRoot)/artifacts/runtime-archive.txt" Lines="$(IlcSdkPath)$(FullRuntimeName).a" Overwrite="true" />
    <PropertyGroup>
      <PalSourceAuditArg Condition="'$(PalSourceManifest)' != ''">--source-manifest &quot;$(PalSourceManifest)&quot;</PalSourceAuditArg>
    </PropertyGroup>
    <Exec Command="python3 &quot;$(PalRoot)/integration/dotnet10/symbols.py&quot; --runtime &quot;$(IlcSdkPath)$(FullRuntimeName).a&quot; $(PalSourceAuditArg)" />
  </Target>
</Project>
