<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <PublishTrimmed>true</PublishTrimmed><SelfContained>true</SelfContained>
    <MSBuildEnableWorkloadResolver>false</MSBuildEnableWorkloadResolver>
    <UseAppHost>false</UseAppHost><InvariantGlobalization>true</InvariantGlobalization>
    <InvariantTimezone>true</InvariantTimezone><LinkerFlavor>lld</LinkerFlavor>
    <IlcLlvmExceptionHandlingModel>emulated</IlcLlvmExceptionHandlingModel>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <PalRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../..'))</PalRoot>
    <PalLib Condition="'$(PalLib)' == ''">$(PalRoot)/target/wasm32-wasip1/release/libdotnet_pal_rs.a</PalLib>
    <PalWrap Condition="'$(PalWrap)' == ''">false</PalWrap>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.DotNet.ILCompiler.LLVM" Version="10.0.0-rc.1.26357.1" />
    <PackageReference Include="runtime.$(NETCoreSdkRuntimeIdentifier).Microsoft.DotNet.ILCompiler.LLVM" Version="10.0.0-rc.1.26357.1" />
    <DirectPInvoke Include="__Internal" />
    <!-- A real whole-module limit, including the 64 MiB Rust arena and native data. -->
    <LinkerArg Include="-Wl,--max-memory=134217728" />
    <NativeLibrary Include="$(PalRoot)/artifacts/llvm/p1_error_text.o" />
    <NativeLibrary Include="$(PalObserverObject)" />
    <NativeLibrary Include="$(PalRoot)/artifacts/llvm/minipal_entropy.o" />
    <NativeLibrary Include="$(PalHeapObject)" Condition="'$(PalHeapObject)' != ''" />
    <NativeLibrary Include="$(PalLib)" />
    <NativeLibrary Include="$(PalBridgeObject)" Condition="'$(PalBridgeObject)' != ''" />
  </ItemGroup>
  <Import Project="../../artifacts/llvm/wrap.props" Condition="'$(PalWrap)' == 'true'" />
  <Target Name="RecordCompilerRuntime" BeforeTargets="LinkNativeLlvm" DependsOnTargets="SetupOSSpecificProps">
    <Exec Command="python3 &quot;$(PalRoot)/integration/llvm-wasi/prepare_bcl.py&quot; --check --framework &quot;$(IlcFrameworkPath)&quot; --sdk &quot;$(IlcSdkPath)&quot;" />
    <WriteLinesToFile File="$(PalRoot)/artifacts/llvm/runtime-archive.txt" Lines="$(IlcSdkPath)libPortableRuntime.a" Overwrite="true" />
    <PropertyGroup>
      <PalSourceArg Condition="'$(PalSourceManifest)' != ''">--source-manifest &quot;$(PalSourceManifest)&quot;</PalSourceArg>
    </PropertyGroup>
    <Exec Command="python3 &quot;$(PalRoot)/integration/llvm-wasi/symbols.py&quot; --runtime &quot;$(IlcSdkPath)libPortableRuntime.a&quot; --nm &quot;$(WASI_SDK_PATH)/bin/llvm-nm&quot; $(PalSourceArg)" />
  </Target>
</Project>
