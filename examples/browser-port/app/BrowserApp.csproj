<Project Sdk="Microsoft.NET.Sdk">
  <!-- A C# application compiled by the experimental NativeAOT LLVM toolchain for
       wasi-wasm and linked against the browser port: GC memory and the runtime
       clock reach the page through dotnet-pal-rs, libc/BCL calls through the
       page's WASI Preview 1 host (host/wasi.mjs). Build with build-app.sh. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <PublishTrimmed>true</PublishTrimmed><SelfContained>true</SelfContained>
    <MSBuildEnableWorkloadResolver>false</MSBuildEnableWorkloadResolver>
    <UseAppHost>false</UseAppHost><InvariantGlobalization>true</InvariantGlobalization>
    <InvariantTimezone>true</InvariantTimezone><LinkerFlavor>lld</LinkerFlavor>
    <IlcLlvmExceptionHandlingModel>emulated</IlcLlvmExceptionHandlingModel>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <AssemblyName>BrowserApp</AssemblyName>
    <PalRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../..'))</PalRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.DotNet.ILCompiler.LLVM" Version="10.0.0-rc.1.26357.1" />
    <PackageReference Include="runtime.$(NETCoreSdkRuntimeIdentifier).Microsoft.DotNet.ILCompiler.LLVM" Version="10.0.0-rc.1.26357.1" />
    <DirectPInvoke Include="__Internal" />
  </ItemGroup>
  <!-- Generated by examples/browser-port/build.rs through dotnet-pal-build:
       the port archive, the adapter archive, the wrap and memory linker arguments. -->
  <Import Project="$(PalProps)" Condition="'$(PalProps)' != ''" />
  <Target Name="RequirePalProps" BeforeTargets="Build">
    <Error Condition="'$(PalProps)' == ''" Text="Pass -p:PalProps=path/to/browser-port.props (written by cargo build of the browser-port crate for wasm32-wasip1)." />
  </Target>
  <Target Name="AuditBclOverlay" BeforeTargets="LinkNativeLlvm" DependsOnTargets="SetupOSSpecificProps">
    <Exec Command="python3 &quot;$(PalRoot)/integration/llvm-wasi/prepare_bcl.py&quot; --check --framework &quot;$(IlcFrameworkPath)&quot; --sdk &quot;$(IlcSdkPath)&quot;" />
    <Exec Command="python3 &quot;$(PalRoot)/integration/llvm-wasi/symbols.py&quot; --runtime &quot;$(IlcSdkPath)libPortableRuntime.a&quot; --nm &quot;$(WASI_SDK_PATH)/bin/llvm-nm&quot;" />
  </Target>
</Project>
